  <sharedRules>
    <rule name="Supercruise" id="1e01-efd7-928b-7e80" hidden="false">
      <description>At the start of this Unit&apos;s activation, you may declare it will Supercruise. If you do, all its Weapons and any enemy Weapons targeting it suffer -1Ac until the end of the Round.</description>
    </rule>
    <rule name="Nanomachines" id="673c-8408-1c52-77dd" hidden="false">
      <description>This Weapon has the Indirect and Ineffective: Zones special rules. It cannot target Aircraft and cannot attack while Sited.</description>
    </rule>
  </sharedRules>
  <sharedSelectionEntries>
    <selectionEntry name="RXs-120 Smoothbore" id="408c-5f22-ab06-62e4" hidden="false" import="true" type="upgrade">
